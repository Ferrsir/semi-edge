# Copy to .env (git-ignored) and fill in. NEVER commit real values.
# PAPER credentials only - key IDs must start with "PK". Live keys are rejected.

# --- Safety flags (defaults shown; these are the only safe defaults) ---
# TRADING_MODE: scanner | backtest | paper   (live is unsupported and refuses to start)
TRADING_MODE=scanner
# ENABLE_ORDER_SUBMISSION: true is only accepted with TRADING_MODE=paper
ENABLE_ORDER_SUBMISSION=false
# ALLOW_LIVE_TRADING: must remain false; true refuses to start
ALLOW_LIVE_TRADING=false

# --- Alpaca PAPER account (Alpaca dashboard -> Paper account -> API keys) ---
ALPACA_PAPER_API_KEY=
ALPACA_PAPER_SECRET_KEY=

# --- Notifications (Phase 4) ---
DISCORD_WEBHOOK_URL=

# --- Paths / logging (optional) ---
# SEMIEDGE_CONFIG_DIR=config
# SEMIEDGE_DATA_DIR=data
# SEMIEDGE_LOG_LEVEL=INFO
# SEMIEDGE_LOG_FORMAT=json
